#!/usr/bin/env bash

set -euo pipefail

# install.sh symlinks this file into a bin directory, so follow the link (and
# any relative links in a chain) to find the clone that holds the other scripts.
# A loop rather than `readlink -f`, which older macOS readlink doesn't support.
# `cd -P` so relative links resolve against the real directory, like the kernel.
launcher="${BASH_SOURCE[0]}"
while [[ -L "$launcher" ]]; do
  launcher_dir="$(cd -P "$(dirname "$launcher")" && pwd)"
  launcher="$(readlink "$launcher")"
  [[ "$launcher" = /* ]] || launcher="$launcher_dir/$launcher"
done
SCRIPT_DIR="$(cd -P "$(dirname "$launcher")" && pwd)"

case "${1:-restart}" in
  restart|start)
    exec "$SCRIPT_DIR/restart.sh"
    ;;
  stop|kill)
    exec "$SCRIPT_DIR/kill.sh"
    ;;
  setup|install)
    exec "$SCRIPT_DIR/setup_mac.sh"
    ;;
  uninstall)
    exec "$SCRIPT_DIR/uninstall.sh"
    ;;
  *)
    echo "Usage: mikey-mouse [restart|start|stop|kill|setup|install|uninstall]" >&2
    exit 2
    ;;
esac
